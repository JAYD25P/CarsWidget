<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collection_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center" android:background="@android:color/transparent" android:padding="3dp">
    <ImageView android:id="@+id/car_one" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="First car"/>
    <ImageView android:id="@+id/car_two" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Second car"/>
    <ImageView android:id="@+id/car_three" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Third car"/>
</LinearLayout>